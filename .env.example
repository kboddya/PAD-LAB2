# Shared Security & Messaging
JWT_SECRET=dev-super-secret-change-in-production-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-32chars
TRUST_PROXY_HEADERS=true
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
LOG_LEVEL=INFO
LOG_JSON=true

# PostgreSQL credentials (Docker Compose)
POSTGRES_USER=shopflow_user
POSTGRES_PASSWORD=shopflow_password

# Per-Service Database URLs (override for local SQLite or Docker PostgreSQL)
AUTH_DATABASE_URL=postgresql+psycopg2://shopflow_user:shopflow_password@postgres:5432/auth_db
USER_DATABASE_URL=postgresql+psycopg2://shopflow_user:shopflow_password@postgres:5432/user_db
PRODUCT_DATABASE_URL=postgresql+psycopg2://shopflow_user:shopflow_password@postgres:5432/product_db
ORDER_DATABASE_URL=postgresql+psycopg2://shopflow_user:shopflow_password@postgres:5432/order_db
PAYMENT_DATABASE_URL=postgresql+psycopg2://shopflow_user:shopflow_password@postgres:5432/payment_db
NOTIFICATION_DATABASE_URL=postgresql+psycopg2://shopflow_user:shopflow_password@postgres:5432/notification_db

# Service URLs (Docker DNS names, never localhost between containers)
AUTH_SERVICE_URL=http://auth-service:8001
USER_SERVICE_URL=http://user-service:8002
PRODUCT_SERVICE_URL=http://product-service:8003
ORDER_SERVICE_URL=http://order-service:8004
PAYMENT_SERVICE_URL=http://payment-service:8005
NOTIFICATION_SERVICE_URL=http://notification-service:8006

# Gateway Rate Limiting & Timeouts
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
PROXY_TIMEOUT_SECONDS=10.0
